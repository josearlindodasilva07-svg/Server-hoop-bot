-- SERVER HOP BLINDADO (tenta vários, embaralha)
-- ═══════════════════════════════════════════════════════════════════
local function fazerServerHop()
    log("🔄 Iniciando Server Hop...", Color3.fromRGB(255, 190, 100))

    local TeleportService = game:GetService("TeleportService")
    local servidores = {}

    local cursor = nil
    for page = 1, 3 do
        local ok = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. PLACE_ID ..
                "/servers/Public?sortOrder=Asc&limit=100" ..
                (cursor and ("&cursor=" .. cursor) or "")
            local resp = game:HttpGet(url, true, {
                ["User-Agent"] = "Roblox/WinInet",
                ["Accept"] = "application/json",
            })
            local data = Http:JSONDecode(resp)
            if data and data.data then
                for _, srv in ipairs(data.data) do
                    if tonumber(srv.playing) and tonumber(srv.maxPlayers)
                        and tonumber(srv.playing) < tonumber(srv.maxPlayers)
                        and tostring(srv.id) ~= game.JobId then
                        table.insert(servidores, srv)
                    end
                end
                cursor = data.nextPageCursor
            end
        end)
        if not ok or not cursor then break end
        task.wait(0.3)
    end

    if #servidores == 0 then
        log("❌ Sem servidores. Rejoin...", Color3.fromRGB(255, 90, 130))
        pcall(function() TeleportService:Teleport(PLACE_ID, LocalPlayer) end)
        return
    end

    log("→ " .. #servidores .. " servidores válidos.", Color3.fromRGB(170, 110, 255))

    for i = #servidores, 2, -1 do
        local j = math.random(i)
        servidores[i], servidores[j] = servidores[j], servidores[i]
    end

    for i, srv in ipairs(servidores) do
        local jobId = tostring(srv.id)
        log("🚀 " .. i .. "/" .. #servidores .. " → " .. jobId:sub(1, 8), Color3.fromRGB(170, 110, 255))

        local falhou = false
        local conn = TeleportService.TeleportInitFailed:Connect(function()
            falhou = true
        end)

        local okTp = pcall(function()
            TeleportService:TeleportToPlaceInstance(PLACE_ID, jobId, LocalPlayer)
        end)

        local t0 = os.clock()
        while not falhou and os.clock() - t0 < 5 do task.wait(0.2) end
        conn:Disconnect()

        if okTp and not falhou then
            log("✅ Teleporte enviado!", Color3.fromRGB(100, 220, 160))
            task.wait(10)
        else
            log("⚠️ Falhou. Próximo...", Color3.fromRGB(255, 190, 100))
            task.wait(0.5)
        end
    end

    log("❌ Todos falharam. Rejoin.", Color3.fromRGB(255, 90, 130))
    pcall(function() TeleportService:Teleport(PLACE_ID, LocalPlayer) end)
end

