-- SCANNER COM TIMEOUT
-- ═══════════════════════════════════════════════════════════════════
local function lerOvosComTimeout()
    local resultado = nil
    local finalizado = false
    task.spawn(function()
        local ok, snap = pcall(function() return AskFieldEggSnapshot:InvokeServer() end)
        if ok and snap and snap.Records then resultado = snap end
        finalizado = true
    end)
    local t0 = os.clock()
    while not finalizado and os.clock() - t0 < 5 do task.wait(0.1) end
    return resultado
end

local publishedKey = nil
local tentativasErro = 0

