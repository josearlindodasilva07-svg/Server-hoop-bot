local function sendDiscordLog(titleTxt, description, color)
    local httpReq = (syn and syn.request) or (http and http.request) or (http_request) or (fluxus and fluxus.request) or (krnl and krnl.request) or (request)
    if not httpReq then return end
    local embed = {
        title = "🤖 Shadow Bot | " .. titleTxt,
        description = description,
        color = color or 10181046,
        footer = { text = "Conta: " .. LocalPlayer.Name .. " | " .. os.date("%H:%M:%S") }
    }
    local body = Http:JSONEncode({ username = "Shadow Bot", embeds = { embed } })
    pcall(function()
        httpReq({ Url = DISCORD_WEBHOOK, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body })
    end)
end

