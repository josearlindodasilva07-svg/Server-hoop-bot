local function fazerServerHop()
    log("🔄 Iniciando Server Hop...", Color3.fromRGB(255, 190, 100))
    sendDiscordLog("🔄 Server Hop", "Procurando novo servidor...", 3447003)
    
    local sucesso = false
    
    pcall(function()
        log("→ Buscando servidores públicos...", Color3.fromRGB(170, 110, 255))
        
        local resp = game:HttpGet("https://games.roblox.com/v1/games/" .. PLACE_ID .. "/servers/Public?sortOrder=Asc&limit=100")
        local data = Http:JSONDecode(resp)
        
        if data and data.data and #data.data > 0 then
            log("→ " .. #data.data .. " servidores encontrados.", Color3.fromRGB(170, 110, 255))
            
            for _, srv in ipairs(data.data) do
                if tonumber(srv.playing) < tonumber(srv.maxPlayers) and tostring(srv.id) ~= game.JobId then
                    log("🚀 Teleportando para " .. tostring(srv.id):sub(1, 8) .. "...", Color3.fromRGB(100, 220, 160))
                    
                    local okTp = pcall(function()
                        game:GetService("TeleportService"):TeleportToPlaceInstance(PLACE_ID, tostring(srv.id), LocalPlayer)
                    end)
                    
                    if okTp then
                        log("✅ Teleporte enviado!", Color3.fromRGB(100, 220, 160))
                        sucesso = true
                        task.wait(5)
                        break
                    end
                end
            end
        else
            log("❌ API não retornou servidores.", Color3.fromRGB(255, 90, 130))
        end
    end)
    
    if not sucesso then
        log("❌ Hop falhou. Usando Rejoin...", Color3.fromRGB(255, 90, 130))
        sendDiscordLog("❌ Hop Falhou", "Usando rejoin padrão.", 15105570)
        pcall(function()
            game:GetService("TeleportService"):Teleport(PLACE_ID, LocalPlayer)
        end)
    end
end

