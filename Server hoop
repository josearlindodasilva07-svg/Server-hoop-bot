    task.wait(3)
    
    while true do
        task.wait(math.random(8, 15))
        
        log("→ Lendo ovos...", Color3.fromRGB(170, 110, 255))
        local snap = lerOvosComTimeout()
        
        if not snap then
            tentativasErro = tentativasErro + 1
            log("⚠️ Timeout (" .. tentativasErro .. "/3)", Color3.fromRGB(255, 190, 100))
            if tentativasErro >= 3 then
                log("❌ 3 falhas seguidas. Server Hop.", Color3.fromRGB(255, 90, 130))
                fazerServerHop()
                return
            end
            continue
        end
        
        tentativasErro = 0
        
        local lista = {}
        for _, r in ipairs(snap.Records) do
            if r and r.Uid and (r.State == "Slot" or r.State == "Dropped") then
                local d = getEggData(r)
                if d then table.insert(lista, d) end
            end
        end
        
        table.sort(lista, function(a,b) return a.Geracao > b.Geracao end)
        
        local best = lista[1]
        if best then
            log("🥚 Melhor ovo: " .. best.Nome .. " (" .. fmtVal(best.Geracao) .. ")", Color3.fromRGB(100, 220, 160))
            local key = tostring(best.Uid) .. "|" .. tostring(best.Geracao)
