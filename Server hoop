-- FUNÇÕES DE DADOS
-- ═══════════════════════════════════════════════════════════════════
local function fmtVal(n)
    n = tonumber(n) or 0
    local function f(v,s) local r = string.format("$%.1f%s/s", v, s); return r:gsub("%.0","") end
    if n >= 1e15 then return f(n/1e15,"Q") end
    if n >= 1e12 then return f(n/1e12,"T") end
    if n >= 1e9  then return f(n/1e9,"B") end
    if n >= 1e6  then return f(n/1e6,"M") end
    if n >= 1e3  then return f(n/1e3,"K") end
    return "$" .. tostring(math.floor(n)) .. "/s"
end

local function scaleMult(scale)
    local n = tonumber(scale) or 1
    if n <= 5 then return n ^ 1.85 end
    return (n / 5) ^ 1.2 * 19.637875755794113
end

local function getEggData(record)
    if not AssetsDir then return nil end
    local asset = AssetsDir[record.AssetCategory]
    if not asset then return nil end
    local baseRate = tonumber(asset.EarningRate) or 0
    local scale = tonumber(record.AssetScale) or 1
    local mutMult = 1
    if record.Mutations and #record.Mutations > 0 and Mutations and type(Mutations.EarningsFor) == "function" then
        local ok, r = pcall(Mutations.EarningsFor, record.Mutations)
        if ok then mutMult = tonumber(r) or 1 end
    end
    local gen = baseRate * scaleMult(scale) * mutMult
    local rarName = asset.Rarity and (asset.Rarity.DisplayName or asset.Rarity.Name) or ""
    return {
        Uid = record.Uid,
        Nome = asset.DisplayName or record.AssetCategory,
        Geracao = math.round(gen),
        RarityName = rarName,
    }
end

