                    }, "\n"), 10181046)
                end)
                
                -- 0.3s só pra garantir que o request já está em voo antes do teleporte
                task.wait(0.3)
                fazerServerHop()
                return
            end
        else
            log("→ Nenhum ovo válido.", Color3.fromRGB(150, 130, 180))
        end
    end
end)
